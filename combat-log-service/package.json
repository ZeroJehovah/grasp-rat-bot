{
  "name": "grasp-rat-combat-log-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local JSONL combat log collector for Grasp Rat Bot",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node analyze-logs.js --self-test",
    "analyze": "node analyze-logs.js",
    "analyze:current": "node analyze-logs.js --manifest ../dist/manifest.json",
    "validate:current": "node analyze-logs.js --manifest ../dist/manifest.json --require-entries --fail-on-issue",
    "validate:objective": "node analyze-logs.js --manifest ../dist/manifest.json --require-entries --require-exit-events --require-active-combat-events --require-hp-disadvantage-exit-events --fail-on-issue",
    "monitor": "node analyze-logs.js --watch",
    "monitor:current": "node analyze-logs.js --watch --manifest ../dist/manifest.json",
    "monitor:current:strict": "node analyze-logs.js --watch --manifest ../dist/manifest.json --require-entries --fail-on-issue",
    "monitor:objective": "node analyze-logs.js --watch --manifest ../dist/manifest.json --require-entries --require-exit-events --require-active-combat-events --require-hp-disadvantage-exit-events --fail-on-issue"
  }
}
