[Unit]
Description=Grasp Rat Browserless Runner
Documentation=https://github.com/ZeroJehovah/grasp-rat-bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Nice=-10
WorkingDirectory=/opt/grasp-rat-browserless/current
EnvironmentFile=/etc/grasp-rat/browserless-runner.env
EnvironmentFile=/opt/grasp-rat-browserless/current/release.env
ExecStart=/usr/bin/node browserless-runner.cjs
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/opt/grasp-rat-browserless
InaccessiblePaths=/home/ubuntu/grasp-rat-bot/src
ReadWritePaths=/var/lib/grasp-rat-browserless /var/log/grasp-rat-browserless

[Install]
WantedBy=multi-user.target
