# Grasp Rat browserless runner production environment.
# Install path: /etc/grasp-rat/browserless-runner.env
# Keep this file readable only by the service operator/root. It can contain the
# reusable manually authorized game session token.

GRASP_RAT_BROWSERLESS_GAME_ORIGIN=https://grasp-rat-game.h-e.top
GRASP_RAT_BROWSERLESS_WS_PATH=/ws
GRASP_RAT_BROWSERLESS_WS_EXTRA_QUERY=compress=gzip%2Cdeflate
GRASP_RAT_BROWSERLESS_SNAPSHOT_PATH=/snapshot
GRASP_RAT_BROWSERLESS_TARGET_WHITELIST_URL=https://raw.githubusercontent.com/ZeroJehovah/grasp-rat-bot/main/dist/target-whitelist.json
GRASP_RAT_BROWSERLESS_TARGET_WHITELIST_FILE=/home/ubuntu/grasp-rat-bot/src/dist/target-whitelist.json
GRASP_RAT_BROWSERLESS_TARGET_WHITELIST_TIMEOUT_MS=7000
GRASP_RAT_BROWSERLESS_TARGET_WHITELIST_MAX_NAMES=100

GRASP_RAT_BROWSERLESS_DATA_DIR=/var/lib/grasp-rat-browserless
GRASP_RAT_BROWSERLESS_LOG_DIR=/var/log/grasp-rat-browserless
GRASP_RAT_BROWSERLESS_LOG_RETENTION_DAYS=2

GRASP_RAT_BROWSERLESS_STATUS_HOST=127.0.0.1
GRASP_RAT_BROWSERLESS_STATUS_PORT=18767
GRASP_RAT_BROWSERLESS_WEB_TOKEN=replace-with-a-long-random-token

# Safe default. Change to false only for a supervised live canary.
GRASP_RAT_BROWSERLESS_DRY_RUN=true
GRASP_RAT_BROWSERLESS_ONCE=false
GRASP_RAT_BROWSERLESS_CANARY_PROFILE=read-only
GRASP_RAT_BROWSERLESS_CONTROL_MODE=read-only
GRASP_RAT_BROWSERLESS_READ_ONLY=true

# Manual session values. Do not commit real values.
GRASP_RAT_BROWSERLESS_USER_ID=0
GRASP_RAT_BROWSERLESS_SESSION_TOKEN=

# Required before live canaries: the last known safe login point.
GRASP_RAT_BROWSERLESS_LOGIN_POINT_X=
GRASP_RAT_BROWSERLESS_LOGIN_POINT_Y=
GRASP_RAT_BROWSERLESS_LOGIN_POINT_HP=

# Invulnerable AFK arrival planning and evidence-gated close-kill timing.
GRASP_RAT_BROWSERLESS_INVULNERABLE_PROFIT_APPROACH_DISTANCE_CM=1000
GRASP_RAT_BROWSERLESS_INVULNERABLE_PROFIT_APPROACH_SLACK_MS=10000
GRASP_RAT_BROWSERLESS_INVULNERABLE_PROFIT_AXIS_SPEED_CM_PER_SEC=950
GRASP_RAT_BROWSERLESS_INVULNERABLE_PROFIT_DIAGONAL_SPEED_CM_PER_SEC=940
GRASP_RAT_BROWSERLESS_INVULNERABLE_PROFIT_ROUTE_SEGMENT_OVERHEAD_MS=120
GRASP_RAT_BROWSERLESS_AFK_ATTACK_FIRE_MAX_RANGE_CM=14500
GRASP_RAT_BROWSERLESS_AFK_ATTACK_DYNAMIC_FIRE_ENABLED=true
GRASP_RAT_BROWSERLESS_AFK_ATTACK_OWN_DAMAGE_RATE_HP_PER_SEC=3
GRASP_RAT_BROWSERLESS_AFK_ATTACK_EXTERNAL_DAMAGE_RATE_HP_PER_SEC=2.05
GRASP_RAT_BROWSERLESS_AFK_ATTACK_PROJECTILE_SPEED_CM_PER_SEC=10000
GRASP_RAT_BROWSERLESS_AFK_ATTACK_HP_SAFETY_BUFFER=3

GRASP_RAT_BROWSERLESS_READONLY_PROBE_MS=30000
GRASP_RAT_BROWSERLESS_FRAME_GAP_ALERT_MS=2000
GRASP_RAT_BROWSERLESS_TRANSPORT_HEALTH_WINDOW_MS=10000
GRASP_RAT_BROWSERLESS_TRANSPORT_HEALTH_ACTIVE_WARMUP_MS=1000
GRASP_RAT_BROWSERLESS_TRANSPORT_HEALTH_ACTIVE_HOLD_MS=2500
GRASP_RAT_BROWSERLESS_TRANSPORT_LATENCY_DECISION_WINDOW_MS=3000
GRASP_RAT_BROWSERLESS_TRANSPORT_LATENCY_EXIT_MS=2500
GRASP_RAT_BROWSERLESS_TRANSPORT_LATENCY_EXIT_SUSTAIN_MS=2000
GRASP_RAT_BROWSERLESS_TRANSPORT_FRAME_LOSS_EXIT_RATE=0.05
GRASP_RAT_BROWSERLESS_TRANSPORT_FRAME_LOSS_EXIT_SUSTAIN_MS=2000
GRASP_RAT_BROWSERLESS_TRANSPORT_FRAME_LOSS_MINIMUM_EXPECTED_TICKS=100
GRASP_RAT_BROWSERLESS_WS_CONNECT_TIMEOUT_MS=10000
GRASP_RAT_BROWSERLESS_HTTP_TIMEOUT_MS=10000
GRASP_RAT_BROWSERLESS_SOURCE_IP_PROBE_TIMEOUT_MS=60000
GRASP_RAT_BROWSERLESS_LEAVE_RETRY_MAX=3
GRASP_RAT_BROWSERLESS_LEAVE_RETRY_MS=200
GRASP_RAT_BROWSERLESS_LEAVE_HEDGE_MS=1000

GRASP_RAT_BROWSERLESS_DECISION_INTERVAL_MS=1000
GRASP_RAT_BROWSERLESS_LOOP_DELAY_MS=30000
GRASP_RAT_BROWSERLESS_DAILY_FIRST_LOGIN_DELAY_MS=0
GRASP_RAT_BROWSERLESS_LOGIN_POINT_SAFETY_SUCCESS_REQUIRED=1
GRASP_RAT_BROWSERLESS_LOGIN_POINT_SAFETY_PROBE_INTERVAL_MS=30000
GRASP_RAT_BROWSERLESS_LOGIN_POINT_SINGLE_BLOCKER_BYPASS_MS=3600000
GRASP_RAT_BROWSERLESS_STALE_SELF_MS=3000
GRASP_RAT_BROWSERLESS_STALE_SELF_CONFIRM_MS=2000
GRASP_RAT_BROWSERLESS_NO_SELF_GRACE_MS=3000
GRASP_RAT_BROWSERLESS_STAMINA_EXHAUSTED_BELOW_MS=200

GRASP_RAT_BROWSERLESS_MOVEMENT_COMMAND_INTERVAL_MS=500
GRASP_RAT_BROWSERLESS_MOVEMENT_TARGET_DEAD_ZONE_CM=900
GRASP_RAT_BROWSERLESS_MOVEMENT_SETTLEMENT_FRAMES=2

# Reuse the existing online global HTTP snapshot for bounded remote-profit navigation.
GRASP_RAT_BROWSERLESS_REMOTE_PROFIT_TARGETS_ENABLED=true

# With live combat enabled, keep a lone realtime 1-coin drop as bait and wait within 10m.
GRASP_RAT_BROWSERLESS_SINGLE_COIN_BAIT_ENABLED=true
GRASP_RAT_BROWSERLESS_SINGLE_COIN_BAIT_HOLD_RADIUS_CM=1000

# Outside this center, only a continuous three-minute no-profit wait triggers a leave.
GRASP_RAT_BROWSERLESS_CENTER_ACTIVITY_RADIUS_CM=100000
# The fixed 130000cm self-position hard boundary is enforced in strategy code: only a high-value coin may continue there.
GRASP_RAT_BROWSERLESS_OUTSIDE_CENTER_IDLE_EXIT_MS=180000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_MAX_MS=60000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_SUPPRESS_MS=60000
GRASP_RAT_BROWSERLESS_DANGEROUS_TARGET_COOLDOWN_MS=900000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_MIN_DAMAGE_MS=60000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_MIN_DAMAGE_HP=10
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_SOFT_MOVEMENT_STAMINA_MS=100000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_HARD_NO_DAMAGE_MS=180000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_HARD_MOVEMENT_STAMINA_MS=300000
GRASP_RAT_BROWSERLESS_PROFIT_PURSUIT_PRESSURE_CYCLE_MS=60000
# 0 derives the Drop-aware time needed to produce the reference damage below.
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_WINDOW_MS=0
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_REFERENCE_DAMAGE_HP=9
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_EXPECTED_DAMAGE_PER_SHOT=3
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_EXPECTED_SHOT_CADENCE_MS=160
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_MINIMUM_WINDOW_MS=1000
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_CLOSE_STEP_CM=1000
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_MINIMUM_DISTANCE_CM=1000
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_REQUIRED_CLOSER_RATIO=0.5
GRASP_RAT_BROWSERLESS_COMBAT_EFFICIENCY_SAMPLE_GAP_CAP_MS=250
GRASP_RAT_BROWSERLESS_COMBAT_RESPONSE_POLICY_SHADOW_CONFIRM_TICKS=6
GRASP_RAT_BROWSERLESS_COMBAT_RESPONSE_POLICY_SHADOW_MINIMUM_HOLD_MS=500
# Keep the five-strategy evasive aim experiment live, with a strict early
# detector and the existing half-efficiency-window fallback.
GRASP_RAT_BROWSERLESS_COMBAT_EVASIVE_AIM_ENABLED=true
GRASP_RAT_BROWSERLESS_COMBAT_EVASIVE_AIM_EARLY_DETECTION_ENABLED=true
# Apply 1 coin / 10 stamina to new ordinary-profit targets while today's stamina can still be burned before UTC+8 reset.
GRASP_RAT_BROWSERLESS_DYNAMIC_PROFIT_THRESHOLD_ENABLED=true
GRASP_RAT_BROWSERLESS_PROFIT_THRESHOLD_COINS_PER_10_STAMINA=1
GRASP_RAT_BROWSERLESS_PROFIT_THRESHOLD_HOURLY_STAMINA_LIMIT=3000
GRASP_RAT_BROWSERLESS_PROFIT_THRESHOLD_RESET_RESERVE_MS=3600000

# Optional deep diagnostics. Payload logging can be large; keep off unless debugging.
GRASP_RAT_BROWSERLESS_WS_TRACE_ENABLED=false
GRASP_RAT_BROWSERLESS_WS_TRACE_PAYLOAD=true
GRASP_RAT_BROWSERLESS_WS_TRACE_MAX_PAYLOAD_CHARS=0

# Login preflight discovers every IPv4 on this interface. SOURCE_IPS is kept
# only for upgrade compatibility and must remain empty after rollout.
GRASP_RAT_BROWSERLESS_SOURCE_IP_INTERFACE=enp0s6
GRASP_RAT_BROWSERLESS_SOURCE_IP=
GRASP_RAT_BROWSERLESS_SOURCE_IPS=

# Live combat remains explicit and default-off.
GRASP_RAT_BROWSERLESS_COMBAT_ENABLED=false
GRASP_RAT_BROWSERLESS_COMBAT_MOVEMENT_STABILITY_ENABLED=false
GRASP_RAT_BROWSERLESS_COMBAT_SHOOT_MIN_INTERVAL_MS=160
