# Grasp Rat browserless runner production environment.
# Install path: /etc/grasp-rat/browserless-runner.env
# Keep this file readable only by the service operator/root. It can contain the
# reusable manually authorized game session token.

GRASP_RAT_BROWSERLESS_GAME_ORIGIN=https://grasp-rat-game.h-e.top
GRASP_RAT_BROWSERLESS_WS_PATH=/ws
GRASP_RAT_BROWSERLESS_WS_EXTRA_QUERY=compress=gzip%2Cdeflate
GRASP_RAT_BROWSERLESS_SNAPSHOT_PATH=/snapshot

GRASP_RAT_BROWSERLESS_DATA_DIR=/var/lib/grasp-rat-browserless
GRASP_RAT_BROWSERLESS_LOG_DIR=/var/log/grasp-rat-browserless
GRASP_RAT_BROWSERLESS_LOG_RETENTION_DAYS=3

GRASP_RAT_BROWSERLESS_STATUS_HOST=127.0.0.1
GRASP_RAT_BROWSERLESS_STATUS_PORT=18767
GRASP_RAT_BROWSERLESS_WEB_TOKEN=replace-with-a-long-random-token

# Safe default. Change to false only for a supervised live canary.
GRASP_RAT_BROWSERLESS_DRY_RUN=true
GRASP_RAT_BROWSERLESS_ONCE=false
GRASP_RAT_BROWSERLESS_CANARY_PROFILE=read-only
GRASP_RAT_BROWSERLESS_CONTROL_MODE=read-only
GRASP_RAT_BROWSERLESS_READ_ONLY=true

# Manual session values. Do not commit real values.
GRASP_RAT_BROWSERLESS_USER_ID=0
GRASP_RAT_BROWSERLESS_SESSION_TOKEN=

# Required before live canaries: the last known safe login point.
GRASP_RAT_BROWSERLESS_LOGIN_POINT_X=
GRASP_RAT_BROWSERLESS_LOGIN_POINT_Y=
GRASP_RAT_BROWSERLESS_LOGIN_POINT_HP=

GRASP_RAT_BROWSERLESS_READONLY_PROBE_MS=30000
GRASP_RAT_BROWSERLESS_FRAME_GAP_ALERT_MS=5000
GRASP_RAT_BROWSERLESS_WS_CONNECT_TIMEOUT_MS=10000
GRASP_RAT_BROWSERLESS_HTTP_TIMEOUT_MS=10000
GRASP_RAT_BROWSERLESS_LEAVE_RETRY_MAX=3
GRASP_RAT_BROWSERLESS_LEAVE_RETRY_MS=1200

GRASP_RAT_BROWSERLESS_DECISION_INTERVAL_MS=1000
GRASP_RAT_BROWSERLESS_LOOP_DELAY_MS=30000
GRASP_RAT_BROWSERLESS_STALE_SELF_MS=3000
GRASP_RAT_BROWSERLESS_NO_SELF_GRACE_MS=3000
GRASP_RAT_BROWSERLESS_STAMINA_EXHAUSTED_BELOW_MS=200

GRASP_RAT_BROWSERLESS_MOVEMENT_COMMAND_INTERVAL_MS=500
GRASP_RAT_BROWSERLESS_MOVEMENT_TARGET_DEAD_ZONE_CM=900
GRASP_RAT_BROWSERLESS_MOVEMENT_SETTLEMENT_FRAMES=2

# Live combat remains explicit and default-off.
GRASP_RAT_BROWSERLESS_COMBAT_ENABLED=false
GRASP_RAT_BROWSERLESS_COMBAT_SHOOT_MIN_INTERVAL_MS=160
