[Unit]
Description=Grasp Rat Headless Demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/grasp-rat-bot
ExecStart=/usr/bin/env node /opt/grasp-rat-bot/headless-demo/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=GRASP_RAT_DEMO_HOST=0.0.0.0
Environment=GRASP_RAT_DEMO_PORT=18766
Environment=GRASP_RAT_DEMO_DATA_DIR=/var/lib/grasp-rat-headless-demo
Environment=GRASP_RAT_DEMO_LOG_DIR=/var/log/grasp-rat-headless-demo
Environment=GRASP_RAT_DEMO_WEB_TOKEN=change-this-before-start
Environment=GRASP_RAT_DEMO_WS_PATH=/ws
Environment=GRASP_RAT_DEMO_WS_EXTRA_QUERY=view=50000

[Install]
WantedBy=multi-user.target
